<Window x:Class="Burl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Burl" Height="600" Width="1100">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <Button Content="Open repository"
                    Click="OpenRepository_Click"
                    HorizontalAlignment="Left"
                    Padding="12,6" />
            <TextBlock x:Name="RepositoryPathText" Margin="0,10" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ChangedFilesList"
                     Grid.Column="0"
                     SelectionChanged="ChangedFilesList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsStaged, Mode=OneWay}"
                                      Click="StageCheckBox_Click"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Type}" Width="80" Foreground="Gray" />
                            <TextBlock Text="{Binding Path}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <ListBox x:Name="DiffList"
                     Grid.Column="2"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="13">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Added">
                                <Setter Property="Background" Value="#E6FFEC" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Removed">
                                <Setter Property="Background" Value="#FFEBE9" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Hunk">
                                <Setter Property="Background" Value="#DDF4FF" />
                                <Setter Property="Foreground" Value="#57606A" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Header">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
