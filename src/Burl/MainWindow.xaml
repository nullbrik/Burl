<Window x:Class="Burl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Burl" Height="450" Width="800">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <Button Content="Open repository"
                    Click="OpenRepository_Click"
                    HorizontalAlignment="Left"
                    Padding="12,6" />
            <TextBlock x:Name="RepositoryPathText" Margin="0,10" />
        </StackPanel>

        <ListBox x:Name="ChangedFilesList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsStaged, Mode=OneWay}"
                                  Click="StageCheckBox_Click"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Type}" Width="90" Foreground="Gray" />
                        <TextBlock Text="{Binding Path}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
